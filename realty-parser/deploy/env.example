# Настройки сканера на сервере. Файл: /opt/anapa-scan/app/.env (права 600, в git не попадает).
TG_BOT_TOKEN=
TG_CHAT_ID=
# куда слать технические сообщения (отчёт ⚙️, сигналы ⚠️ о сбоях). Всегда ваш chat id, НЕ клиента
ADMIN_CHAT_ID=
# дополнительные получатели через запятую (могут и управлять поисками)
TG_EXTRA_CHAT_IDS=
# мобильный прокси РФ для Авито: http://логин:пароль@хост:порт
AVITO_PROXY_URL=
# ссылка смены IP из кабинета прокси (https://...)
AVITO_PROXY_ROTATE_URL=
# интервал проверок в минутах (5, 10, 15, 20, 30); после изменения запустить install.sh
SCAN_EVERY=15
# браузер и режимы (менять не нужно)
BROWSER_PATH=/usr/bin/yandex-browser-stable
AVITO_ROTATE_TRIES=8
AVITO_ROTATE_WAIT=10
AVITO_PER_RUN=0
NO_JS=0
NO_BLOCK=0
# время суточного отчёта администратору (МСК); отчёт приходит раз в день
DAILY_REPORT_TIME=22:30
